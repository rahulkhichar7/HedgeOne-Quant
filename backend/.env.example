# Copy to backend/.env and fill in.  Never commit the real .env.

# Upstox analytics token — read-only, valid for one year, no daily login.
# Create it at https://account.upstox.com/developer/apps  →  Analytics Token
UPSTOX_ANALYTICS_TOKEN=

# Optional
# HEDGEONE_DATA_DIR=D:/market-data        # where candles / reports / instrument lists are stored (default: ./data)
# HEDGEONE_TZ=Asia/Kolkata                # timestamps are stored as naive local time of this zone
# HOST=127.0.0.1
# PORT=8000
