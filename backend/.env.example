# Copy to backend/.env and fill in.  Never commit the real .env.

# Fyers API v3 app (https://myapi.fyers.in/dashboard)
FYERS_CLIENT_ID=XXXXXXXXXX-100
FYERS_SECRET_KEY=XXXXXXXXXX
FYERS_REDIRECT_URI=https://127.0.0.1/

# Optional
# HEDGEONE_DATA_DIR=D:/market-data        # where candles / reports / tokens are stored (default: ./data)
# HEDGEONE_TZ=Asia/Kolkata                # timestamps are stored as naive local time of this zone
# HOST=127.0.0.1
# PORT=8000
